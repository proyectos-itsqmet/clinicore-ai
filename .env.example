# Copiar este archivo como ".env" y completar los valores.
# El ".env" NUNCA se sube al repositorio (ver .gitignore).

# Clave de la API de OpenAI. Se obtiene en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REEMPLAZAR

# ---------------------------------------------------------------------------
# MODELO DE TEXTO
#
# Se usa "gpt-5.6-luna", el mismo del notebook de clase y el que el docente
# recomendo por precio. Segun la nomenclatura que explico:
#
#     gpt-5.6-sol     = version Pro       (la mas costosa)
#     gpt-5.6-terra   = version normal    (2 USD entrada / 12 USD salida)
#     gpt-5.6-luna    = version mini      (0.20 USD entrada / 1.20 USD salida)
#
# Cita: "el modelo que vamos a ocupar para generalmente realizar pruebas
# es esta version de 5.6 Luna, no nos cuesta apenas 20 centavos en la entrada
# y en la salida 1.20 USD. Es bastante barato, bastante economico."
#
# OJO: estos nombres pueden ser alias del proyecto de OpenAI del docente. Si
# "python probar.py modelos" NO los lista, hay que reemplazarlos por uno de
# los que si aparezcan (buscar el que tenga "mini" o "nano" en el nombre, que
# son los economicos).
# ---------------------------------------------------------------------------
OPENAI_MODEL=gpt-5.6-luna

# ---------------------------------------------------------------------------
# MODELO DE TRANSCRIPCION DE AUDIO
# El mismo del notebook (celda 33). El docente lo describio como "no es tan
# caro". Se cobra por minuto de audio, no por tokens.
# ---------------------------------------------------------------------------
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# URL del backend Spring del QMS.
QMS_API_URL=http://localhost:8080

# Puerto en el que corre este servidor Flask.
PORT=8000

# Origenes autorizados (Angular y Flutter web), separados por coma.
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,http://localhost:5000

# Tamano maximo del audio en bytes (8 MB, mas o menos un minuto).
MAX_AUDIO_BYTES=8000000
